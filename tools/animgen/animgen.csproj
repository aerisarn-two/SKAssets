<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>animgen</AssemblyName>
    <RootNamespace>SKAssets.AnimGen</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      HKSK writes the files and reads no plugin; SKAssets.Content reads the
      records it needs from the load order and hands them over in memory.
    -->
    <ProjectReference Include="../../src/SKAssets.Content/SKAssets.Content.csproj" />
  </ItemGroup>

</Project>
